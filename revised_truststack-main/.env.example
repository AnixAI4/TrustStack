# Copy to .env.local and fill in. NEVER commit .env.local.
# Every value below is a placeholder — no real secret belongs in this file.

# --- Supabase (project region MUST be Mumbai ap-south-1) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Server-only. Bypasses RLS entirely. Never prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Server-only. HMAC key (>= 32 chars) signing the active-organisation cookie (D-021).
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ACTIVE_ORG_COOKIE_SECRET=<random-48-bytes-base64url>

# --- Email (invite links, D-025) ---
# Server-only. Resend API key with "Sending access" restricted to notify.truststack.co.in.
RESEND_API_KEY=<resend-sending-key>
INVITE_EMAIL_FROM=TrustStack <no-reply@notify.truststack.co.in>

# --- Prisma ---
# Runtime uses the POOLED port 6543; migrations use the DIRECT port 5432.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.<ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# --- Seed / tests ---
# Password for the seeded example.com test users. Local/dev project only.
SEED_USER_PASSWORD=<generated-test-password>

# --- AI (backend only, from Slice 11) ---
# The platform kill switch: anything but "true" keeps the AI assistant OFF for every
# organisation (SLICE_11 §4.8). Leave it off until the sub-processor contracts exist (§6, A1).
AI_ENABLED=false
# anthropic (default) · fake (CI and e2e only — refuses to run on the live site)
AI_PROVIDER=anthropic
# Server-only. Read by apps/web/lib/ai/claude.ts alone. Never prefix NEXT_PUBLIC_.
ANTHROPIC_API_KEY=<anthropic-key>
# Optional: the model id (default claude-opus-5-5) and, for a client-hosted install,
# its own endpoint; AI_SERVER_FALLBACK=off where the endpoint has no server-side fallback.
# AI_MODEL=claude-opus-5-5
# ANTHROPIC_BASE_URL=https://<client-endpoint>
# AI_SERVER_FALLBACK=off

# --- App ---
NEXT_PUBLIC_APP_NAME=TrustStack DPDP Compass
NEXT_PUBLIC_APP_URL=http://localhost:3000
