{
  "name": "@truststack/core",
  "version": "0.0.0",
  "private": true,
  "description": "Framework-free DPDP domain logic. No Next.js, React, Supabase or Prisma imports (D-004).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vitest": "^5.0.0"
  }
}
