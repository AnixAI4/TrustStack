# TrustStack Environment Variables
# Copy this file to .env.local and fill in your values

# =============================================================================
# SUPABASE
# =============================================================================
# Get these from your Supabase project dashboard: Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Service key (server-side only, never expose to client)
# Used for subscription management and admin operations
SUPABASE_SERVICE_KEY=eyJ...

# Alias used by TrustStack Platform APIs (same value as SUPABASE_SERVICE_KEY)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Optional dedicated HMAC key for board-share and vendor-questionnaire links.
# Generate at least 32 random bytes. If unset, the service-role key is used.
TRUSTDECK_TOKEN_SECRET=replace-with-at-least-32-random-bytes

# Enable only after 02_session_registry.sql has been applied successfully.
ENFORCE_DEVICE_SESSIONS=0
# Allowed range is 1-5; the server clamps values outside this range.
MAX_CONCURRENT_DEVICES=2

# =============================================================================
# RAZORPAY (live KYC-verified payments — pilot + extra scans + templates)
# =============================================================================
# Use Live API keys from Razorpay Dashboard → Account & Settings → API Keys.
# Test/sandbox keys (rzp_test_…) are blocked unless RAZORPAY_ALLOW_TEST=1.
PAYMENT_GATEWAY=razorpay
RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_KEY_SECRET=
# Webhook signing secret (Dashboard → Developers → Webhooks) — not the API secret
RAZORPAY_WEBHOOK_SECRET=
# Optional Razorpay Plan id for Growth/Pilot recurring billing (orders still work without it)
RAZORPAY_PLAN_GROWTH=
# Ops email when a payment succeeds (needs RESEND_API_KEY)
LEAD_NOTIFICATION_EMAIL=
# Local sandbox only — never set in production
# RAZORPAY_ALLOW_TEST=1

# =============================================================================
# SUBSCRIPTION PRICING (in paise, 100 paise = ₹1)
# =============================================================================
# Pilot monthly subscription
PILOT_PRICE_PAISE=99900
PILOT_ORIGINAL_PRICE_PAISE=299900

# Display price (for UI)
NEXT_PUBLIC_PILOT_PRICE_DISPLAY=999
NEXT_PUBLIC_PILOT_ORIGINAL_PRICE_DISPLAY=2999

# Per-template unlock - prices live on each template in content/templates.ts
# (₹49 / ₹99 / ₹149 / ₹199). These env vars are unused fallbacks only.
# TEMPLATE_PRICE_PAISE=9900
# NEXT_PUBLIC_TEMPLATE_PRICE_DISPLAY=99

# =============================================================================
# SCANNER (in-app /scanner + /security - Python agent)
# =============================================================================
# Backend used by POST /api/scanner and /api/security-scanner.
# Local: start with `cd scanner-agent && python main.py --server` (port 8090).
SCANNER_SERVICE_URL=http://127.0.0.1:8090

# =============================================================================
# APP URL (for OAuth callbacks, email links)
# =============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=TrustStack

# =============================================================================
# AI (Anthropic Claude - TrustChat, platform drafts, AI Compliance Manager)
# =============================================================================
# Get your key from https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Optional model override (code default is currently claude-haiku-4-5)
# To revert to Sonnet later: ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MODEL=claude-haiku-4-5
# ANTHROPIC_MAX_TOKENS=5000

# AI Compliance Manager: live | mock | off
# When unset, uses "live" if ANTHROPIC_API_KEY is set, else mock in dev / off in prod
# AI_COMPLIANCE_MODE=live

# Optional: branded DSR OTP emails via Resend. If unset, Supabase Auth sends the code.
# RESEND_API_KEY=

# Optional: gates POST /api/platform/breach/escalations/run (Vercel Cron / scheduler)
# CRON_SECRET=