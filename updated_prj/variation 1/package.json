{
  "name": "truststack-variation-1",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "predev": "node scripts/free-port.mjs 3000",
    "dev": "next dev --turbopack -p 3000",
    "dev:webpack": "next dev -p 3000",
    "clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\"",
    "dev:clean": "npm run clean && npm run dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:compliance-manager": "node --conditions=react-server --import tsx --test tests/security-compliance-manager.test.ts",
    "test:platform-security": "node --conditions=react-server --import tsx --test tests/platform-assessment-isolation.test.ts tests/platform-database-security.test.ts",
    "test:platform-performance": "node --import tsx --test tests/platform-performance.test.ts",
    "verify:compliance-manager": "node scripts/verify-security-compliance-manager.mjs",
    "verify:compliance-manager:live": "node scripts/verify-live-security-compliance-manager.mjs",
    "audit:i18n": "node scripts/translate-site-content.mjs --extract-only && node scripts/audit-translations.mjs",
    "audit:i18n:routes": "node scripts/audit-i18n-routes.mjs",
    "audit:scanner-score": "node --import tsx scripts/audit-scanner-score.mjs",
    "translate:site": "node scripts/translate-site-content.mjs",
    "generate:templates": "node scripts/generate-templates.mjs",
    "generate:rules": "node scripts/build-rules-content.mjs",
    "generate:act": "node scripts/build-act-content.mjs",
    "generate:easy": "node scripts/generate-easy-content.mjs",
    "test:e2e": "playwright test",
    "test:e2e:compass": "playwright test tests/e2e/dpdp-compass.spec.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.36.3",
    "@google/genai": "^2.31.0",
    "@radix-ui/react-accordion": "^1.2.2",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-scroll-area": "^1.2.2",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@react-pdf/renderer": "^4.5.1",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.108.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx-preview": "^0.3.7",
    "framer-motion": "^11.15.0",
    "jspdf": "^2.5.2",
    "lucide-react": "0.469.0",
    "next": "^15.5.19",
    "next-intl": "^4.13.0",
    "next-themes": "^0.4.4",
    "pdf-parse": "^1.1.1",
    "qrcode": "^1.5.4",
    "react": "19.0.0",
    "react-countup": "^6.5.3",
    "react-dom": "19.0.0",
    "react-hot-toast": "^2.4.1",
    "react-intersection-observer": "^9.14.0",
    "react-type-animation": "^3.2.0",
    "resend": "^6.14.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "docx": "^9.7.1",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.19",
    "pdfkit": "^0.19.1",
    "postcss": "^8.4.49",
    "tailwindcss": "3.4.17",
    "tsx": "^4.23.0",
    "typescript": "^5.7.2"
