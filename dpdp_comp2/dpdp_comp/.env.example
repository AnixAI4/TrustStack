# Copy to .env and fill in values — never commit .env

# Environment
FLASK_ENV=development
# Generate for production: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=
FLASK_DEBUG=1
PORT=5000

# Persistent data (results, uploads, jobs, logs)
DATA_DIR=.

# Rotating application log (Flask)
LOG_FILE=./scanner.log
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5

# Site access control (strongly recommended when deployed)
APP_PASSWORD=

# Cloudflare Turnstile (bot protection for signup + free scans)
# Create keys at: https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SECRET_KEY=
# Set to 1 to reject requests when TURNSTILE_SECRET_KEY is missing
TURNSTILE_REQUIRED=0

# Secret for /api/* — must match INTERNAL_API_KEY in web/.env.local
API_KEY=

# DeepSeek (primary analysis engine)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Rate limiting (in-memory; use GUNICORN_WORKERS=1 for accurate limits)
RATE_LIMIT_ENABLED=1
RATE_LIMIT_SCANS_PER_HOUR=10

# Scan limits
SCAN_JOB_TIMEOUT_SECONDS=600
MAX_CONCURRENT_SCANS=3

# Gunicorn (production / Render Docker)
# Keep WORKERS=1 when using Selenium or in-memory rate limits.
GUNICORN_WORKERS=1
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=300
# Render sets PORT automatically — do not hardcode in production
# PORT=5000

# Docker / Render Chromium (set automatically in Dockerfile)
# CHROME_BIN=/usr/bin/chromium
# CHROMEDRIVER_PATH=/usr/bin/chromedriver
# DATA_DIR=/data

# Report versioning (optional overrides)
SCANNER_VERSION=1.0.0
RULES_VERSION=DPDP Rules 2025 (Nov 2025 Gazette)

# Premium paywall — Free (FREE_SCANS_PER_USER preview scans) + One-Time Report (₹299)
PREMIUM_ENABLED=1
PREMIUM_FREE_ACCESS=0
PREMIUM_PREVIEW_MISSING_INDICATORS=3
PREMIUM_PRICE_PAISE=29900
FREE_SCANS_PER_USER=1
ANONYMOUS_FREE_SCANS=0
PREMIUM_CURRENCY=INR

# Razorpay — Live KYC-verified keys for real payments (rzp_live_…)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# From Razorpay Dashboard → Webhooks (signing secret, not API key secret)
RAZORPAY_WEBHOOK_SECRET=
# Optional recurring plan id
RAZORPAY_PLAN_GROWTH=

# Supabase — quotas, unlocks, auth (run supabase/schema.sql first)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_PUBLISHABLE_KEY=
