# TrustStack™ — environment template.
# Copy to .env.local (gitignored) and fill in real values. Every variable the app
# actually reads is listed here; NEXT_PUBLIC_* are exposed to the browser, all
# others are server-only and must NEVER be prefixed NEXT_PUBLIC_.

# ── Required ──────────────────────────────────────────────────────────────────

# Supabase (project must be in ap-south-1 / Mumbai for DPDP data residency)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# Server-only. Bypasses RLS — used by the admin client for public routes + cron.
# NEVER expose to the browser, never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Anthropic Claude API (TrustChat, assessment gaps, notice/DPA/DPBI/board drafts)
ANTHROPIC_API_KEY=your_anthropic_api_key

# Resend — transactional email (grievance/DSR notifications, vendor questionnaire,
# breach escalations). Sending from noreply@anixai.io until truststack.in is verified.
RESEND_API_KEY=your_resend_key

# Public base URL — used in email links and public widgets. Set to the deployed
# origin in production (e.g. https://truststack.in).
NEXT_PUBLIC_APP_URL=http://localhost:3011
NEXT_PUBLIC_APP_NAME=Anix AI TrustStack

# ── Optional ──────────────────────────────────────────────────────────────────

# M8 Breach Response — escalation alert runner.
# Shared secret that gates POST /api/breach/escalations/run. There is no user
# session for that endpoint, so an external scheduler (Vercel Cron, a GitHub
# Action, or Supabase pg_cron) must send it as either:
#   - header  x-cron-secret: <value>
#   - header  Authorization: Bearer <value>   (Vercel Cron default)
# Until this is set, the escalation endpoint denies all callers (returns 401).
# CRON_SECRET=your_long_random_secret
